#version 450
// Scaffold kernel: proves dispatch -> storage buffer -> host readback.
// Writes a linear-space gradient; io/ppm.h tonemaps it like any render.
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform Push
{
    uint width;
    uint height;
} pc;

layout(binding = 0) buffer Frame
{
    float pixels[];
};

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    if (x >= pc.width || y >= pc.height)
        return;
    uint i = (y * pc.width + x) * 3;
    pixels[i + 0] = float(x) / float(pc.width);
    pixels[i + 1] = float(y) / float(pc.height);
    pixels[i + 2] = 0.25;
}
