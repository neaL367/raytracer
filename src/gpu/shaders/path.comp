#version 450
#extension GL_GOOGLE_include_directive : enable
#extension GL_GOOGLE_cpp_style_line_directive : enable
// Full path tracer: cosine diffuse, metal/glass, emissive quads,
// NEE + power-heuristic MIS + Russian roulette. Mirrors CPU
// integrator formulas in fp32. RNG is wang-hash (differs from CPU
// mt19937 by design -> statistical parity, not bit-exact).
#include "common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba32f) uniform image2D img;
layout(binding = 1) uniform Cam {
    GPUCam cam;
};
// Scene buffers + traversal live in common.glsl (shared with normal).
// Binding 7: concatenated image texels (linear, top-first rows).
// Binding 8: per-image (offset, w, h, 0) lookup table.
layout(binding = 7) readonly buffer ImgTex {
    vec4 imgTex[];
};
layout(binding = 8) readonly buffer ImgTable {
    ivec4 imgTab[];
};
// Binding 9: NEE light table, ivec2 (type, index): 0 quad, 1 sphere, 2 tri.
layout(binding = 9) readonly buffer LightTab {
    ivec2 lightTab[];
};
// Bindings 10-11: albedo + normal AOV outputs (always written, read by the
// joint pass; no RNG involved so beauty streams stay bit-exact).
layout(binding = 10, rgba32f) uniform image2D albImg;
layout(binding = 11, rgba32f) uniform image2D nrmImg;
// Binding 12: HDRI texels (RGBA32f, W*H, row 0 = top). Unused when nenv != 2.
layout(binding = 12) readonly buffer HdriTex {
    vec4 hdriTex[];
};
// Binding 13: HDRI CDF buffer. Layout (all float):
//   [0] = W, [1] = H, [2..H+2] = marginal CDF (H+1),
//   [H+3 .. H+3+H*(W+1)-1] = conditional CDFs row-major.
layout(binding = 13) readonly buffer HdriCdf {
    float hdriCdf[];
};
#include "push_block.glsl"

uint wseed;
uint wrand() {
    wseed = uint(wseed ^ 61) ^ (wseed >> 16);
    wseed *= 9u;
    wseed ^= wseed >> 4;
    wseed *= 0x27d4eb2du;
    wseed ^= wseed >> 15;
    return wseed;
}
float wrandf() {
    if (pc.fixed_rng != 0)
        return 0.5;
    return float(wrand()) / 4294967296.0;
}
vec3 wrand_in_sphere() {
    for (int i = 0; i < 16; ++i) {
        vec3 p = 2.0 * vec3(wrandf(), wrandf(), wrandf()) - vec3(1.0);
        if (dot(p, p) < 1.0)
            return p;
    }
    return vec3(0.0, 0.0, 1.0);
}
vec3 wcosine_dir() {
    float r1 = wrandf();
    float r2 = wrandf();
    float phi = 6.28318530718 * r1;
    return vec3(cos(phi) * sqrt(r2), sin(phi) * sqrt(r2), sqrt(1.0 - r2));
}
void wonb(vec3 n, out vec3 u, out vec3 v, out vec3 w) {
    w = normalize(n);
    vec3 a = abs(w.x) > 0.9 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    v = normalize(cross(w, a));
    u = cross(v, w);
}

// Bilinear sample of one pyramid level, same edge math as CPU.
vec3 bilin_at(int off, int iw, int ih, float u, float v) {
    float fx = u * float(iw - 1);
    float fy = (1.0 - v) * float(ih - 1);
    int x0 = int(floor(fx));
    int y0 = int(floor(fy));
    int x1 = min(x0 + 1, iw - 1);
    int y1 = min(y0 + 1, ih - 1);
    float tx = fx - float(x0);
    float ty = fy - float(y0);
    vec3 c00 = imgTex[off + y0 * iw + x0].xyz;
    vec3 c10 = imgTex[off + y0 * iw + x1].xyz;
    vec3 c01 = imgTex[off + y1 * iw + x0].xyz;
    vec3 c11 = imgTex[off + y1 * iw + x1].xyz;
    return c00 * ((1.0 - tx) * (1.0 - ty)) + c10 * (tx * (1.0 - ty)) +
           c01 * ((1.0 - tx) * ty) + c11 * (tx * ty);
}
// Distance LOD mirrors CPU mip_select (fp32; level-boundary flips are
// rare single-level noise, inside statistical parity).
float mip_lod(float t, int iw, int ih, float span) {
    float tex = float(max(iw, ih)) / (float(pc.H) * span);
    return max(log2(max(t, 1e-3) * tex), 0.0);
}
// Trilinear image sample over the uploaded pyramid (levels consecutive;
// table stride is 2 rows: entry, then spanbits row).
vec3 image_sample(vec2 uv, int img_idx, float t) {
    ivec4 entry = imgTab[img_idx * 2];
    float span = uintBitsToFloat(uint(imgTab[img_idx * 2 + 1].x));
    float lod = mip_lod(t, entry.y, entry.z, span);
    int maxl = max(entry.w - 1, 0);
    float lc = clamp(lod, 0.0, float(maxl));
    int l0 = int(floor(lc));
    float fr = lc - float(l0);
    float u = clamp(uv.x, 0.0, 1.0);
    float v = clamp(uv.y, 0.0, 1.0);
    int off = entry.x, iw = entry.y, ih = entry.z;
    for (int l = 0; l < 12; ++l) {
        if (l >= l0)
            break;
        off += iw * ih;
        iw = max(iw / 2, 1);
        ih = max(ih / 2, 1);
    }
    vec3 a = bilin_at(off, iw, ih, u, v);
    if (fr <= 0.0 || l0 >= maxl)
        return a;
    int ow = iw, oh = ih;
    iw = max(iw / 2, 1);
    ih = max(ih / 2, 1);
    off += ow * oh;
    vec3 b = bilin_at(off, iw, ih, u, v);
    return a * (1.0 - fr) + b * fr;
}

// GGX conductor core: mirrors CPU ggx.h (fp32). Height-correlated
// Smith ratio + Schlick F0 + Heitz VNDF, 2 RNG draws like CPU.
float ggx_lambda(float alpha, float cos_w) {
    float t = sqrt(max(1.0 - cos_w * cos_w, 0.0)) / cos_w;
    float a = alpha * t;
    return (sqrt(1.0 + a * a) - 1.0) * 0.5;
}
vec3 ggx_vndf(float alpha, vec3 V, float u1, float u2, out vec3 H) {
    vec3 Vh = normalize(vec3(alpha * V.x, alpha * V.y, V.z));
    float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
    vec3 T1 = lensq > 0.0 ? vec3(-Vh.y, Vh.x, 0.0) / sqrt(lensq) : vec3(1.0, 0.0, 0.0);
    vec3 T2 = cross(Vh, T1);
    float r = sqrt(u1);
    float phi = 6.28318530718 * u2;
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float s = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - s) * sqrt(max(1.0 - t1 * t1, 0.0)) + s * t2;
    vec3 Nh = T1 * t1 + T2 * t2 + Vh * sqrt(max(1.0 - t1 * t1 - t2 * t2, 0.0));
    H = normalize(vec3(alpha * Nh.x, alpha * Nh.y, max(Nh.z, 0.0)));
    return H * (2.0 * dot(V, H)) - V; // reflect incident (-V) about H
}

// Anisotropic GGX core: mirrors CPU ggx aniso fns (fp32). Height-
// correlated Smith ratio + Heitz anisotropic VNDF, 2 RNG draws like CPU.
float ggx_lambda_aniso(float ax, float ay, vec3 w) {
    if (w.z <= 0.0)
        return 1e30;
    float tx = w.x / w.z;
    float ty = w.y / w.z;
    float a2 = (ax * tx) * (ax * tx) + (ay * ty) * (ay * ty);
    return (sqrt(1.0 + a2) - 1.0) * 0.5;
}
vec3 ggx_vndf_aniso(float ax, float ay, vec3 V, float u1, float u2, out vec3 H) {
    vec3 Vh = normalize(vec3(ax * V.x, ay * V.y, V.z));
    float lensq = Vh.x * Vh.x + Vh.y * Vh.y;
    vec3 T1 = lensq > 0.0 ? vec3(-Vh.y, Vh.x, 0.0) / sqrt(lensq) : vec3(1.0, 0.0, 0.0);
    vec3 T2 = cross(Vh, T1);
    float r = sqrt(u1);
    float phi = 6.28318530718 * u2;
    float t1 = r * cos(phi);
    float t2 = r * sin(phi);
    float s = 0.5 * (1.0 + Vh.z);
    t2 = (1.0 - s) * sqrt(max(1.0 - t1 * t1, 0.0)) + s * t2;
    vec3 Nh = T1 * t1 + T2 * t2 + Vh * sqrt(max(1.0 - t1 * t1 - t2 * t2, 0.0));
    H = normalize(vec3(ax * Nh.x, ay * Nh.y, max(Nh.z, 0.0)));
    return H * (2.0 * dot(V, H)) - V;
}

vec3 checker_col(vec3 p, vec3 even, vec3 odd, float scale) {
    int s = int(floor(scale * p.x)) + int(floor(scale * p.y)) + int(floor(scale * p.z));
    return (s % 2 == 0) ? even : odd;
}
// Table-free value noise mirroring CPU value_noise (uint32 wrap matches).
uint nlattice(ivec3 c) {
    uint h = uint(c.x) * 374761393u + uint(c.y) * 668265263u + uint(c.z) * 1440662683u;
    h = (h ^ (h >> 13u)) * 1274126177u;
    return h ^ (h >> 16u);
}
float nunit(ivec3 c) {
    return float(nlattice(c) & 0xffffu) / 65535.0;
}
float vnoise(vec3 p) {
    ivec3 b = ivec3(floor(p));
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);
    float c000 = nunit(b), c100 = nunit(b + ivec3(1, 0, 0));
    float c010 = nunit(b + ivec3(0, 1, 0)), c110 = nunit(b + ivec3(1, 1, 0));
    float c001 = nunit(b + ivec3(0, 0, 1)), c101 = nunit(b + ivec3(1, 0, 1));
    float c011 = nunit(b + ivec3(0, 1, 1)), c111 = nunit(b + ivec3(1, 1, 1));
    float x00 = mix(c000, c100, u.x), x10 = mix(c010, c110, u.x);
    float x01 = mix(c001, c101, u.x), x11 = mix(c011, c111, u.x);
    return mix(mix(x00, x10, u.y), mix(x01, x11, u.y), u.z);
}
float vturb(vec3 p, int depth) {
    float sum = 0.0, weight = 0.0, amp = 1.0;
    for (int i = 0; i < 8; ++i) {
        if (i >= depth)
            break;
        sum += amp * abs(vnoise(p));
        weight += amp;
        amp *= 0.5;
        p *= 2.0;
    }
    return weight > 0.0 ? sum / weight : 0.0;
}
// Mode 0 = raw, 1 = turbulence, 2 = marble. Matches CPU noise_texture.
vec3 noise_col(vec3 p, vec3 c0, vec3 c1, float freq, int depth, int mode) {
    vec3 q = p * freq;
    float f = vnoise(q);
    if (mode == 1)
        f = vturb(q, depth);
    else if (mode == 2)
        f = 0.5 * (1.0 + sin(freq * p.z + 10.0 * vturb(q, depth)));
    return c0 * (1.0 - f) + c1 * f;
}

// Analytic sun+sky (mirrors CPU env_light analytic paths).
vec3 env_sky(vec3 d) {
    vec3 unit = normalize(d);
    float tt = 0.5 * (unit.y + 1.0);
    return (1.0 - tt) * vec3(1.0) + tt * vec3(0.5, 0.7, 1.0);
}
vec3 env_sun_dir() {
    return normalize(vec3(0.5, 0.8, 0.35));
}
vec3 env_analytic_radiance(vec3 d) {
    vec3 ud = normalize(d);
    vec3 L = env_sky(ud);
    float s = dot(ud, env_sun_dir());
    if (s > 0.9993) {
        float k = (s - 0.9993) / (1.0 - 0.9993);
        L += vec3(30.0, 25.0, 18.0) * (k * k);
    }
    return L;
}

// ---- HDRI helpers (nenv == 2) ----------------------------------------
// UV convention matches CPU hdri_env and codebase sphere UVs:
//   u = (atan2(-z, x) + pi) / (2*pi),  v = acos(y) / pi

vec2 dir_to_hdri_uv(vec3 d) {
    vec3 ud = normalize(d);
    float phi = atan(-ud.z, ud.x);        // atan2(-z, x) ∈ [-pi, pi]
    float u   = (phi + 3.14159265) / 6.28318530;
    float v   = acos(clamp(ud.y, -1.0, 1.0)) / 3.14159265;
    return vec2(u, v);
}
vec3 hdri_uv_to_dir(float u, float v) {
    float theta = 3.14159265 * v;
    float phi   = 6.28318530 * u;
    float sinT  = sin(theta);
    float cosT  = cos(theta);
    // Inverse of dir_to_hdri_uv: x=-sinT*cos(phi), y=cosT, z=sinT*sin(phi)
    return normalize(vec3(-sinT * cos(phi), cosT, sinT * sin(phi)));
}

vec3 hdri_radiance(vec3 d) {
    int W = int(hdriCdf[0] + 0.5);
    int H = int(hdriCdf[1] + 0.5);
    if (W <= 0 || H <= 0) return vec3(0.0);
    vec2 uv = dir_to_hdri_uv(d);
    float u = clamp(uv.x, 0.0, 1.0);
    float v = clamp(uv.y, 0.0, 1.0);
    float fx = u * float(W - 1);
    float fy = (1.0 - v) * float(H - 1);  // v=0 → top row
    int x0 = int(floor(fx)), y0 = int(floor(fy));
    int x1 = min(x0 + 1, W - 1), y1 = min(y0 + 1, H - 1);
    float tx = fx - float(x0), ty = fy - float(y0);
    vec3 c00 = hdriTex[y0 * W + x0].xyz, c10 = hdriTex[y0 * W + x1].xyz;
    vec3 c01 = hdriTex[y1 * W + x0].xyz, c11 = hdriTex[y1 * W + x1].xyz;
    return c00 * ((1.0-tx)*(1.0-ty)) + c10*(tx*(1.0-ty)) +
           c01 * ((1.0-tx)*ty)       + c11*(tx*ty);
}

// Binary search: largest i in [0,n-1] where cdf[base+i+1] <= key.
int hdri_lb(int base, int n, float key) {
    int lo = 0, hi = n;
    while (lo < hi) {
        int mid = (lo + hi) / 2;
        if (hdriCdf[base + mid + 1] <= key) lo = mid + 1;
        else hi = mid;
    }
    return clamp(lo, 0, n - 1);
}

// Sample from the HDRI CDF. Returns direction and sets pdf_out.
vec3 hdri_sample(float u1, float u2, out float pdf_out) {
    int W = int(hdriCdf[0] + 0.5);
    int H = int(hdriCdf[1] + 0.5);
    if (W <= 0 || H <= 0) { pdf_out = 1.0 / (4.0 * 3.14159265); return vec3(0,1,0); }
    int marg_base = 2;  // marginal CDF starts at hdriCdf[2]
    int vi = hdri_lb(marg_base, H, u1);
    float v0 = hdriCdf[marg_base + vi], v1 = hdriCdf[marg_base + vi + 1];
    float fv  = (v1 > v0) ? (u1 - v0) / (v1 - v0) : 0.5;
    float vf  = (float(vi) + fv) / float(H);

    int cond_base = 2 + H + 1 + vi * (W + 1);
    int ui = hdri_lb(cond_base, W, u2);
    float c0 = hdriCdf[cond_base + ui], c1 = hdriCdf[cond_base + ui + 1];
    float fu  = (c1 > c0) ? (u2 - c0) / (c1 - c0) : 0.5;
    float uf  = (float(ui) + fu) / float(W);

    vec3 dir = hdri_uv_to_dir(uf, vf);
    float sinT = length(vec2(dir.x, dir.z));  // sin(theta) = sqrt(1-y^2)
    float p_uv = (v1 - v0) * float(H) * (c1 - c0) * float(W);
    pdf_out = (sinT > 1e-4) ? p_uv / (2.0 * 3.14159265 * 3.14159265 * sinT) : 0.0;
    return dir;
}

// Evaluate HDRI PDF for a given direction (for MIS miss weight).
float hdri_pdf(vec3 d) {
    int W = int(hdriCdf[0] + 0.5);
    int H = int(hdriCdf[1] + 0.5);
    if (W <= 0 || H <= 0) return 1.0 / (4.0 * 3.14159265);
    vec2 uv = dir_to_hdri_uv(d);
    float sinT = sin(3.14159265 * uv.y);
    if (sinT < 1e-4) return 0.0;
    int vi = clamp(int(uv.y * float(H)), 0, H - 1);
    float marg_diff = (hdriCdf[2 + vi + 1] - hdriCdf[2 + vi]) * float(H);
    int ui = clamp(int(uv.x * float(W)), 0, W - 1);
    int cb = 2 + H + 1 + vi * (W + 1);
    float cond_diff = (hdriCdf[cb + ui + 1] - hdriCdf[cb + ui]) * float(W);
    return marg_diff * cond_diff / (2.0 * 3.14159265 * 3.14159265 * sinT);
}

// Analytic uniform-sphere sample (parity with old env_sample_dir).
vec3 env_analytic_sample_dir(float u1, float u2) {
    float z   = 1.0 - 2.0 * u1;
    float phi = 6.28318530 * u2;
    float r   = sqrt(max(1.0 - z * z, 0.0));
    return vec3(r * cos(phi), r * sin(phi), z);
}
// ---- Dispatch wrappers (used by Li) ------------------------------------
vec3 env_radiance(vec3 d) {
    if (pc.nenv == 2) return hdri_radiance(d);
    return env_analytic_radiance(d);
}
// Sample env direction + return pdf.
vec3 env_sample(float u1, float u2, out float pdf_out) {
    if (pc.nenv == 2) return hdri_sample(u1, u2, pdf_out);
    pdf_out = 1.0 / (4.0 * 3.14159265);
    return env_analytic_sample_dir(u1, u2);   // analytic uniform sphere
}
// Evaluate env PDF for a direction (MIS miss weight).
float env_pdf_for(vec3 d) {
    if (pc.nenv == 2) return hdri_pdf(d);
    return 1.0 / (4.0 * 3.14159265);
}
// Textured emission stays MatType::EMIT; params.y carries image index + 1
// (0 = legacy flat emitter). Returns -1 for flat/non-emissive prims.
int emit_image_index(int ty, int idx) {
    vec4 params = (ty == 0) ? quads[idx].params
                  : ((ty == 1) ? spheres[idx].params : tris[idx].params);
    if (int(params.x + 0.5) != MAT_EMIT || params.y <= 0.5)
        return -1;
    return int(params.y + 0.5) - 1;
}
// UVs for an NEE light sample drawn with (u1, u2): mirrors CPU light_uv
// and the shape hit paths (quad parametric, sphere spherical, tri
// corner-blended or barycentric).
vec2 light_sample_uv(int ty, int idx, float u1, float u2) {
    if (ty == 0)
        return vec2(u1, u2);
    if (ty == 1) {
        float z = 1.0 - 2.0 * u1;
        float phi = 6.28318530718 * u2;
        float rs = sqrt(max(1.0 - z * z, 0.0));
        vec3 off = vec3(rs * cos(phi), rs * sin(phi), z);
        float theta = acos(clamp(off.y, -1.0, 1.0));
        return vec2((atan(-off.z, off.x) + 3.14159265) / 6.28318530,
                    theta / 3.14159265);
    }
    GPUTri tr = tris[idx];
    float su = sqrt(u1);
    float w0 = 1.0 - su;
    float w1 = su * (1.0 - u2);
    float w2 = su * u2;
    if (tr.params.w > 0.5)
        return tr.tuvA.xy * w0 + tr.tuvA.zw * w1 + tr.tuvB.xy * w2;
    return vec2(w1, w2);
}
// Uniform area-light sample mirroring CPU light_point/light_area.
// Consumes exactly 2 RNG draws per shape like the CPU.
void light_sample(int li, float rtime, float u1, float u2, out vec3 lp, out vec3 ln,
                  out float area, out vec3 lemit) {
    ivec2 e = lightTab[li];
    if (e.x == 0) {
        GPUQuad lq = quads[e.y];
        lp = lq.Q.xyz + u1 * lq.u.xyz + u2 * lq.v.xyz;
        ln = normalize(cross(lq.u.xyz, lq.v.xyz));
        area = length(cross(lq.u.xyz, lq.v.xyz));
        lemit = lq.emit.xyz;
    } else if (e.x == 1) {
        GPUSphere s = spheres[e.y];
        float f = (s.tm.y > s.tm.x)
                      ? clamp((rtime - s.tm.x) / (s.tm.y - s.tm.x), 0.0, 1.0)
                      : 0.0;
        vec3 cen = mix(s.c_r.xyz, s.c1.xyz, f);
        float rr = s.c_r.w;
        float z = 1.0 - 2.0 * u1;
        float phi = 6.28318530718 * u2;
        float rs = sqrt(max(1.0 - z * z, 0.0));
        vec3 off = vec3(rs * cos(phi), rs * sin(phi), z);
        lp = cen + rr * off;
        ln = off;
        area = 12.5663706144 * rr * rr; // 4 PI r^2
        lemit = s.emit.xyz;
    } else {
        GPUTri tr = tris[e.y];
        float su = sqrt(u1);
        lp = tr.a.xyz * (1.0 - su) + tr.b.xyz * (su * (1.0 - u2)) +
             tr.c.xyz * (su * u2);
        vec3 fn = cross(tr.b.xyz - tr.a.xyz, tr.c.xyz - tr.a.xyz);
        area = 0.5 * length(fn);
        ln = normalize(fn);
        lemit = tr.emit.xyz;
    }
}
// Geometric area + normal of a BSDF-found emitter (mirrors light_area).
void found_light(int ty, int idx, vec3 hitp, float rtime, out vec3 ln,
                 out float area) {
    if (ty == 0) {
        GPUQuad lq = quads[idx];
        ln = normalize(cross(lq.u.xyz, lq.v.xyz));
        area = length(cross(lq.u.xyz, lq.v.xyz));
    } else if (ty == 1) {
        GPUSphere s = spheres[idx];
        float f = (s.tm.y > s.tm.x)
                      ? clamp((rtime - s.tm.x) / (s.tm.y - s.tm.x), 0.0, 1.0)
                      : 0.0;
        vec3 cen = mix(s.c_r.xyz, s.c1.xyz, f);
        ln = (hitp - cen) / s.c_r.w;
        area = 12.5663706144 * s.c_r.w * s.c_r.w;
    } else {
        GPUTri tr = tris[idx];
        vec3 fn = cross(tr.b.xyz - tr.a.xyz, tr.c.xyz - tr.a.xyz);
        area = 0.5 * length(fn);
        ln = normalize(fn);
    }
}

float schlick(float cosT, float ri) {
    float r0 = (1.0 - ri) / (1.0 + ri);
    r0 *= r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosT, 5.0);
}
// Power heuristic, one sample each: mirrors CPU direction_pdf::power_weight.
float power_weight(float pdf_a, float pdf_b) {
    float a2 = pdf_a * pdf_a, b2 = pdf_b * pdf_b;
    float denom = a2 + b2;
    return denom > 0.0 ? a2 / denom : 0.0;
}
// Push word mixpdf carries two flags (M63 nenv precedent): bit 0 =
// Book-3 mixture, bit 1 = M67 hero-wavelength spectral transport.
bool use_mix() { return (pc.mixpdf & 1) != 0; }
bool use_spectral() { return (pc.mixpdf & 2) != 0; }
// Channel-pick (mirrors spectrum::pick): identity when spectral is off,
// else the hero channel value. The 1/3 hero probability is compensated
// once, by scaling the finished path x3 at the end of Li().
vec3 spick(vec3 v, int hero) {
    if (!use_spectral() || hero < 0)
        return v;
    vec3 z = vec3(0.0);
    if (hero == 0)
        z.x = v.x;
    else if (hero == 1)
        z.y = v.y;
    else
        z.z = v.z;
    return z;
}
float hero_lambda(int hero) {
    if (hero == 0)
        return 650.0;
    return (hero == 1) ? 550.0 : 450.0;
}
float cauchy_ior(float nref, float B, float lambda_nm) {
    if (B == 0.0)
        return nref;
    float l = lambda_nm / 1000.0;
    float lr = 0.5876;
    return nref + B * (1.0 / (l * l) - 1.0 / (lr * lr));
}
// ---- vec2 complex core (mirrors spectrum.h cplx) ----
vec2 cmul(vec2 a, vec2 b) {
    return vec2(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
}
vec2 cdiv(vec2 a, vec2 b) {
    float d = dot(b, b);
    return vec2((a.x * b.x + a.y * b.y) / d, (a.y * b.x - a.x * b.y) / d);
}
float cabs2(vec2 a) { return dot(a, a); }
vec2 csqrt(vec2 a) {
    float r = length(a);
    float t = 0.5 * atan(a.y, a.x);
    float s = sqrt(r);
    return vec2(s * cos(t), s * sin(t));
}
// Exact unpolarized conductor Fresnel (mirrors spectrum::conductor_R).
float conductor_R(float n0, float n, float k, float cos_ti) {
    float c = clamp(cos_ti, 0.0, 1.0);
    float s2 = 1.0 - c * c;
    vec2 N = vec2(n, k);
    vec2 cos2t = vec2(1.0, 0.0) - (n0 * n0 * s2) * cdiv(vec2(1.0, 0.0), cmul(N, N));
    vec2 cost = csqrt(cos2t);
    vec2 rs = cdiv(vec2(n0 * c, 0.0) - cmul(N, cost), vec2(n0 * c, 0.0) + cmul(N, cost));
    vec2 rp = cdiv(cmul(N, vec2(c, 0.0)) - vec2(n0, 0.0) * cost,
                   cmul(N, vec2(c, 0.0)) + vec2(n0, 0.0) * cost);
    return 0.5 * (cabs2(rs) + cabs2(rp));
}
// Amplitude Fresnel pair for one interface (mirrors spectrum::fresnel_ri).
void fresnel_ri_glsl(float n0re, float n0im, float n1re, float n1im, float cos_ti,
                     out vec2 rs, out vec2 rp) {
    float c = clamp(cos_ti, 0.0, 1.0);
    float s2 = 1.0 - c * c;
    vec2 N0 = vec2(n0re, n0im), N1 = vec2(n1re, n1im);
    vec2 cos2t = vec2(1.0, 0.0) - s2 * cdiv(cmul(N0, N0), cmul(N1, N1));
    vec2 cost = csqrt(cos2t);
    rs = cdiv(N0 * c - cmul(N1, cost), N0 * c + cmul(N1, cost));
    rp = cdiv(cmul(N1, vec2(c, 0.0)) - N0 * cost, cmul(N1, vec2(c, 0.0)) + N0 * cost);
}
// Thin-film Airy reflectance, one wavelength (mirrors thinfilm::film_R).
float film_R(float n0, float nf, float d_nm, float ns_n, float ns_k,
             float cos_ti, float lambda_nm) {
    float c = clamp(cos_ti, 0.0, 1.0);
    if (d_nm <= 0.0) {
        if (ns_k == 0.0) {
            vec2 rs, rp;
            fresnel_ri_glsl(n0, 0.0, ns_n, 0.0, c, rs, rp);
            return 0.5 * (cabs2(rs) + cabs2(rp));
        }
        return conductor_R(n0, ns_n, ns_k, c);
    }
    float s2 = 1.0 - c * c;
    float sin2t1 = (n0 * n0 / (nf * nf)) * s2;
    if (sin2t1 >= 1.0)
        return 1.0;
    float cost1 = sqrt(1.0 - sin2t1);
    float rs12 = (n0 * c - nf * cost1) / (n0 * c + nf * cost1);
    float rp12 = (nf * c - n0 * cost1) / (nf * c + n0 * cost1);
    vec2 rs23, rp23;
    fresnel_ri_glsl(nf, 0.0, ns_n, ns_k, cost1, rs23, rp23);
    float delta = 2.0 * 3.14159265 * nf * d_nm * cost1 / lambda_nm;
    vec2 e = vec2(cos(2.0 * delta), sin(2.0 * delta));
    vec2 nums = vec2(rs12, 0.0) + cmul(rs23, e);
    vec2 dens = vec2(1.0, 0.0) + rs12 * cmul(rs23, e);
    vec2 nump = vec2(rp12, 0.0) + cmul(rp23, e);
    vec2 denp = vec2(1.0, 0.0) + rp12 * cmul(rp23, e);
    return 0.5 * (cabs2(cdiv(nums, dens)) + cabs2(cdiv(nump, denp)));
}
vec3 film_R_rgb(float n0, float nf, float d_nm, float ns_n, float ns_k, float cos_ti) {
    return vec3(film_R(n0, nf, d_nm, ns_n, ns_k, cos_ti, 650.0),
                film_R(n0, nf, d_nm, ns_n, ns_k, cos_ti, 550.0),
                film_R(n0, nf, d_nm, ns_n, ns_k, cos_ti, 450.0));
}
bool nk_preset(int id, int ch, out float n, out float k) {
    if (ch < 0 || ch > 2)
        return false;
    if (id == 1) {
        n = (ch == 0) ? 0.17 : ((ch == 1) ? 0.35 : 1.45);
        k = (ch == 0) ? 3.80 : ((ch == 1) ? 2.75 : 1.95);
    } else if (id == 2) {
        n = (ch == 0) ? 0.07 : ((ch == 1) ? 0.13 : 0.16);
        k = (ch == 0) ? 4.20 : ((ch == 1) ? 4.00 : 2.60);
    } else if (id == 3) {
        n = (ch == 0) ? 0.28 : ((ch == 1) ? 0.95 : 1.25);
        k = (ch == 0) ? 3.40 : ((ch == 1) ? 2.65 : 2.40);
    } else if (id == 4) {
        n = (ch == 0) ? 1.45 : ((ch == 1) ? 0.95 : 0.65);
        k = (ch == 0) ? 7.60 : ((ch == 1) ? 6.00 : 5.30);
    } else {
        return false;
    }
    return true;
}

vec3 Li(vec3 o, vec3 d, float rtime, uint hbase, out vec3 guide_a,
         out vec3 guide_n) {
    vec3 throughput = vec3(1.0);
    vec3 L = vec3(0.0);
    vec3 prev = o;
    bool specular = true;
    float pdf_b_last = 0.0;
    guide_a = vec3(0.0);
    guide_n = vec3(0.0);
    int pty = -1, pidx = -1; // previous-bounce prim (bounce trace skips it)
    // Nesting stack (M57): air bottom; mirrors medium_stack (host).
    // M58 frames also carry entry point + absorption for Beer's law.
    float stk_ior[8];
    int stk_pri[8];
    ivec2 stk_id[8];
    vec3 stk_ent[8];
    vec3 stk_abs[8];
    int stk_n = 1;
    stk_ior[0] = 1.0;
    stk_pri[0] = -1;
    stk_id[0] = ivec2(-1, -1);
    stk_ent[0] = vec3(0.0);
    stk_abs[0] = vec3(0.0);
    // M67: one hero channel per path (0/1/2 = 650/550/450nm), drawn once.
    // Off = legacy RGB (no draw, streams bit-exact).
    int hero = 1;
    if (use_spectral()) {
        hero = int(wrandf() * 3.0);
        hero = clamp(hero, 0, 2);
    }
    for (int bounce = 0; bounce < pc.maxdepth; ++bounce) {
        float t;
        vec3 n;
        vec4 alb, alb2, emit, params;
        int light_idx, light_ty;
        vec2 huv;
        vec3 tang;
        bool has_tang;
        int sty = -1, sidx = -1; // beauty-hit prim id (NEE shadow skips it)
        // Fog event (shared helper) vs solid surface: nearest wins.
        // RNG drawn only when fog exists: static streams bit-exact.
        float fog_t = 1e30;
        vec3 fog_alb = vec3(0.0);
        int fog_slot = -1;
        bool has_fog = false;
        if (pc.nfog > 0) {
            // Tracking hashes derive from the sample base (zero wrandf
            // draws): the u01 draw below stays the legacy fog stream.
            // Site 0 = primary: shadow probes use site 1 (no cross-talk).
            has_fog = fog_event(o, d, rtime, pc.ns, wrandf(), 1e30, fog_t, fog_alb,
                                hbase, bounce, 0, fog_slot);
        }
        bool solid =
            trace_solid(o, d, rtime, 1e30, t, n, alb, alb2, emit, params, light_idx,
                        light_ty, huv, tang, has_tang, pty, pidx, 0.5, sty, sidx);
        if (!solid)
            t = 1e30;
        if (has_fog && fog_t < t) {
            // Volume event wins: isotropic continue mirroring CPU
            // (integrator.h: isotropic is_diffuse=false, so no NEE fires
            // here; continuation pdf is 1/4PI, non-specular). Stale
            // pdf_b_last / specular=true corrupted every downstream MIS
            // weight until the next diffuse surface (M44/M48 fog gap).
            // wrand_in_sphere never returns 0 (unit fallback), so normalize
            // is safe directly.
            // First-hit AOV mirrors CPU (phase albedo, arbitrary up normal).
            if (bounce == 0) {
                guide_a = fog_alb;
                guide_n = vec3(0.0, 1.0, 0.0);
            }
            throughput *= spick(fog_alb, hero);
            o = o + d * fog_t;
            prev = o;
            // Volume NEE (M59): direct-light in-scattering at the event,
            // mirroring the CPU phase estimator (uniform phase: no cosS).
            // Draws only on events, so event-free streams stay bit-exact.
            // Density gate (M60): thin media skip back to walks-only
            // (0.01 mirrors kVolumeNeeMinDensity on the host).
            // Shadow sites 3/4 (surface NEE uses 1/2): no hash cross-talk.
            bool vol_nee = fog_slot >= 0 && spheres[fog_slot].params.y >= 0.01;
            if (pc.nlights > 0 && vol_nee && !use_mix()) {
                int li = int(wrandf() * float(pc.nlights));
                li = min(li, pc.nlights - 1);
                vec3 lp, ln, lemit;
                float area;
                float eu1 = wrandf(), eu2 = wrandf();
                light_sample(li, rtime, eu1, eu2, lp, ln, area, lemit);
                vec3 toL = lp - o;
                float dist = length(toL);
                vec3 wi = toL / dist;
                float cosA = abs(dot(ln, -wi));
                if (cosA > 0.0 && area > 0.0) {
                    float Tr = shadow_transmittance(o, wi, rtime, pc.ns, dist,
                                                    hbase, bounce, 3, -1, -1);
                    if (Tr > 0.0) {
                        ivec2 le = lightTab[li];
                        int eimg = emit_image_index(le.x, le.y);
                        vec3 vle = spick((eimg >= 0)
                                                 ? image_sample(light_sample_uv(le.x, le.y, eu1, eu2),
                                                                eimg, dist)
                                                 : lemit,
                                           hero);
                        float pdf_l = dist * dist / (float(pc.nlights) * area * cosA);
                        float pdf_b = 1.0 / (4.0 * 3.14159265);
                        float w = power_weight(pdf_l, pdf_b);
                        L += throughput * vle *
                             (cosA * float(pc.nlights) * area /
                              (4.0 * 3.14159265 * dist * dist)) * w * Tr;
                    }
                }
            }
            if (pc.nenv > 0 && vol_nee && !use_mix()) {
                // Environment in-scattering: sample from active env (analytic
                // or HDRI), probe to infinity, power MIS vs uniform phase.
                float pdf_e = 0.0;
                vec3 edir = env_sample(wrandf(), wrandf(), pdf_e);
                if (pdf_e > 0.0) {
                    float Tr = shadow_transmittance(o, edir, rtime, pc.ns, 1e30,
                                                    hbase, bounce, 4, -1, -1);
                    if (Tr > 0.0) {
                        vec3 envLe = spick(env_radiance(edir), hero);
                        float pdf_b = 1.0 / (4.0 * 3.14159265);
                        float w = power_weight(pdf_e, pdf_b);
                        L += throughput * envLe * (1.0 / (4.0 * 3.14159265 * pdf_e)) *
                             w * Tr;
                    }
                }
            }
            d = normalize(wrand_in_sphere());
            pdf_b_last = 1.0 / (4.0 * 3.14159265);
            specular = use_mix(); // mixture: found lights full
            pty = -1;
            pidx = -1; // event site has no prim: next trace skips nothing
            if (bounce >= 3) {
                float q = min(max(max(throughput.x, throughput.y), throughput.z), 0.95);
                if (q <= 0.0 || wrandf() > q)
                    break;
                throughput /= q;
            }
            continue;
        }
        if (!solid) {
            // Miss with no fog event: sky/env, or black for enclosed
            // scenes (mirrors CPU black_bg: break, no RNG, no radiance).
            // Trace outs are stale here (solid miss), so this branch must
            // come before any use of t/n/alb/emit/params below.
            if (pc.nblack > 0)
                break;
            vec3 miss_L = pc.nenv > 0 ? env_radiance(d) : env_sky(d);
            if (pc.nenv > 0 && !specular) {
                // MIS weight vs active env PDF (HDRI or analytic 1/4PI).
                float w = power_weight(pdf_b_last, env_pdf_for(d));
                L += throughput * miss_L * w;
            } else {
                L += throughput * miss_L;
            }
            break;
        }
        int mtype = int(params.x + 0.5);
        vec3 hitp0 = o + d * t;
        // Type 4 = checker diffuse: world-pos parity like CPU texture.
        // Type MAT_IMAGE = image diffuse: UV sample like CPU image_texture.
        // Type MAT_NOISE = procedural noise: marble family like CPU noise_texture.
        vec3 base_alb = alb.xyz;
        int img_idx = -1;
        if (mtype == MAT_CHECKER)
            base_alb = checker_col(hitp0, alb.xyz, alb2.xyz, params.y);
        else if (mtype == MAT_IMAGE) {
            img_idx = int(params.y + 0.5);
            base_alb = image_sample(huv, img_idx, t);
        } else if (mtype == MAT_NOISE) {
            base_alb = noise_col(hitp0, alb.xyz, alb2.xyz, params.y,
                                 int(params.z + 0.5), int(params.w + 0.5));
        }
        // Textured emission (params.y = image index + 1) samples like an
        // image albedo; flat emission keeps the uploaded emit color.
        int emit_img = (mtype == MAT_EMIT && params.y > 0.5)
                           ? int(params.y + 0.5) - 1
                           : -1;
        // First-hit AOV mirrors CPU surface_albedo (L0, crisp guides).
        // Before the emit break: lights carry guides too (CPU records all).
        if (bounce == 0) {
            guide_n = n;
            if (mtype == MAT_IMAGE && img_idx >= 0)
                guide_a = image_sample(huv, img_idx, 1e-3); // L0, no LOD
            else if (mtype == MAT_CONDUCTOR || mtype == MAT_ANISO)
                guide_a = alb.xyz;
            else if (mtype == MAT_GLASS)
                guide_a = vec3(1.0);
            else if (mtype == MAT_EMIT)
                guide_a = (emit_img >= 0) ? image_sample(huv, emit_img, 1e-3)
                                          : emit.xyz;
            else
                guide_a = base_alb; // MAT_SOLID, MAT_CHECKER, MAT_NOISE
        }
        vec3 emit_col = (mtype == MAT_EMIT)
                            ? spick((emit_img >= 0) ? image_sample(huv, emit_img, t) : emit.xyz, hero)
                            : vec3(0.0);
        if (mtype == MAT_EMIT && (emit_col.x + emit_col.y + emit_col.z > 0.0)) {
            if (specular) {
                L += throughput * emit_col;
            } else if (light_ty >= 0) {
                // BSDF-found emitter: MIS-weight by its geometric pdf so
                // NEE-sampled hits are not double-counted (any shape).
                vec3 hitp = o + d * t;
                vec3 to_hit = hitp - prev;
                float dist = length(to_hit);
                vec3 wi = to_hit / dist;
                vec3 ln;
                float area;
                found_light(light_ty, light_idx, hitp, rtime, ln, area);
                float cosA = abs(dot(ln, -wi));
                float pdf_l = (cosA > 0.0 && area > 0.0)
                                  ? dist * dist / (float(pc.nlights) * area * cosA)
                                  : 0.0;
                float w = (pdf_l <= 0.0) ? 1.0 : power_weight(pdf_b_last, pdf_l);
                L += throughput * emit_col * w;
            } else {
                L += throughput * emit_col;
            }
            break;
        }
        vec3 attenuation;
        vec3 sd;
        bool ok = true;
        bool diffuse = false;
        if (mtype == MAT_SOLID || mtype == MAT_CHECKER || mtype == MAT_IMAGE || mtype == MAT_NOISE) {
            vec3 u, v, w;
            wonb(n, u, v, w);
            vec3 cd = wcosine_dir();
            sd = u * cd.x + v * cd.y + w * cd.z;
            attenuation = base_alb;
            diffuse = true;
        } else if (mtype == MAT_EMIT) {
            ok = false; // emissive has no scatter (CPU returns false);
                        // reached only when emit == 0 (black), absorbed
        } else if (mtype == MAT_CONDUCTOR) {
            // GGX conductor (fuzz-era type 1 deleted): F0 = albedo,
            // perceptual roughness in params.y. Frame faces the view
            // like CPU set_face_normal.
            vec3 V = -normalize(d);
            vec3 nn = dot(n, V) < 0.0 ? -n : n;
            vec3 u, v, w;
            wonb(nn, u, v, w);
            vec3 Vl = vec3(dot(V, u), dot(V, v), dot(V, w));
            float alpha = clamp(params.y, 0.0, 1.0);
            alpha *= alpha;
            vec3 H;
            vec3 Ll = ggx_vndf(alpha, Vl, wrandf(), wrandf(), H);
            if (Ll.z <= 0.0) {
                ok = false; // below-surface lobe absorbed, as CPU
            } else {
                float cvh = max(dot(Vl, H), 0.0);
                float f = 1.0 - cvh;
                // M67 measured n/k (alb2.z) -> exact Fresnel; M68 film
                // overcoat (alb2.x/y) -> Airy; else Schlick-from-F0.
                vec3 F;
                float film_d = alb2.x;
                int nkid = int(alb2.z + 0.5);
                if (film_d > 0.0) {
                    float film_n = alb2.y;
                    if (nkid > 0) {
                        float n0, k0, n1, k1, n2, k2;
                        nk_preset(nkid, 0, n0, k0);
                        nk_preset(nkid, 1, n1, k1);
                        nk_preset(nkid, 2, n2, k2);
                        F = vec3(film_R(1.0, film_n, film_d, n0, k0, cvh, 650.0),
                                 film_R(1.0, film_n, film_d, n1, k1, cvh, 550.0),
                                 film_R(1.0, film_n, film_d, n2, k2, cvh, 450.0));
                    } else {
                        float r0 = (alb.x + alb.y + alb.z) / 3.0;
                        float sq = sqrt(clamp(r0, 0.0, 1.0));
                        float sub_n = (1.0 + sq) / (1.0 - sq + 1e-6);
                        F = film_R_rgb(1.0, film_n, film_d, sub_n, 0.0, cvh);
                    }
                } else if (nkid > 0) {
                    float n0, k0, n1, k1, n2, k2;
                    nk_preset(nkid, 0, n0, k0);
                    nk_preset(nkid, 1, n1, k1);
                    nk_preset(nkid, 2, n2, k2);
                    F = vec3(conductor_R(1.0, n0, k0, cvh),
                             conductor_R(1.0, n1, k1, cvh),
                             conductor_R(1.0, n2, k2, cvh));
                } else {
                    F = alb.xyz + (vec3(1.0) - alb.xyz) * (f * f * f * f * f);
                }
                float lv = ggx_lambda(alpha, Vl.z);
                float ratio = (1.0 + lv) / (1.0 + lv + ggx_lambda(alpha, Ll.z));
                attenuation = F * ratio;
                sd = u * Ll.x + v * Ll.y + w * Ll.z;
            }
        } else if (mtype == MAT_ANISO) {
            // Anisotropic conductor (mirrors CPU metal aniso): TBN frame
            // from the hit tangent, ONB-u fallback by the same rule.
            vec3 V = -normalize(d);
            vec3 nn = dot(n, V) < 0.0 ? -n : n;
            vec3 T = tang - nn * dot(tang, nn);
            if (!has_tang || dot(T, T) <= 1e-12) {
                vec3 u, v, w;
                wonb(nn, u, v, w);
                T = u;
            } else {
                T = normalize(T);
            }
            vec3 B = cross(nn, T);
            vec3 Vl = vec3(dot(V, T), dot(V, B), dot(V, nn));
            float ax = clamp(params.y, 0.0, 1.0);
            float ay = clamp(params.z, 0.0, 1.0);
            ax *= ax;
            ay *= ay;
            vec3 H;
            vec3 La = ggx_vndf_aniso(ax, ay, Vl, wrandf(), wrandf(), H);
            if (La.z <= 0.0) {
                ok = false;
            } else {
                float cvh = max(dot(Vl, H), 0.0);
                float f = 1.0 - cvh;
                // M67 n/k (alb2.z), M68 film overcoat (alb2.x/y).
                vec3 F;
                float film_da = alb2.x;
                int nka = int(alb2.z + 0.5);
                if (film_da > 0.0) {
                    float film_na = alb2.y;
                    if (nka > 0) {
                        float n0, k0, n1, k1, n2, k2;
                        nk_preset(nka, 0, n0, k0);
                        nk_preset(nka, 1, n1, k1);
                        nk_preset(nka, 2, n2, k2);
                        F = vec3(film_R(1.0, film_na, film_da, n0, k0, cvh, 650.0),
                                 film_R(1.0, film_na, film_da, n1, k1, cvh, 550.0),
                                 film_R(1.0, film_na, film_da, n2, k2, cvh, 450.0));
                    } else {
                        float r0a = (alb.x + alb.y + alb.z) / 3.0;
                        float sqa = sqrt(clamp(r0a, 0.0, 1.0));
                        float sub_na = (1.0 + sqa) / (1.0 - sqa + 1e-6);
                        F = film_R_rgb(1.0, film_na, film_da, sub_na, 0.0, cvh);
                    }
                } else if (nka > 0) {
                    float n0, k0, n1, k1, n2, k2;
                    nk_preset(nka, 0, n0, k0);
                    nk_preset(nka, 1, n1, k1);
                    nk_preset(nka, 2, n2, k2);
                    F = vec3(conductor_R(1.0, n0, k0, cvh),
                             conductor_R(1.0, n1, k1, cvh),
                             conductor_R(1.0, n2, k2, cvh));
                } else {
                    F = alb.xyz + (vec3(1.0) - alb.xyz) * (f * f * f * f * f);
                }
                float lv = ggx_lambda_aniso(ax, ay, Vl);
                float ratio = (1.0 + lv) / (1.0 + lv + ggx_lambda_aniso(ax, ay, La));
                attenuation = F * ratio;
                sd = T * La.x + B * La.y + nn * La.z;
            }
        } else if (mtype == MAT_GLASS) {
            float ir = params.z;
            // M67: hero-resolved IOR (Cauchy B rides alb2.x); legacy ir
            // exactly when spectral is off.
            float irg = use_spectral() ? cauchy_ior(ir, alb2.x, hero_lambda(hero)) : ir;
            float rough = clamp(params.y, 0.0, 1.0);
            // Nesting resolve (M57): pop on origin-prim re-hit, push on
            // higher priority, else legacy front_face eta. Mirrors the
            // host medium_stack exactly (pri lives in params.w, sigma in
            // alb.xyz). M58: Beer's law on the exit chord.
            float nest_eta = 0.0;
            bool nest_ok = false;
            {
                int spri = int(params.w + 0.5);
                int top = stk_n - 1;
                if (stk_n > 1 && sty == stk_id[top].x && sidx == stk_id[top].y) {
                    nest_eta = stk_ior[top] / stk_ior[top - 1];
                    nest_ok = true;
                    float chord = distance(hitp0, stk_ent[top]);
                    throughput *= exp(-stk_abs[top] * chord);
                    --stk_n;
                } else if (spri > stk_pri[top] && stk_n < 8) {
                    nest_eta = stk_ior[top] / irg;
                    nest_ok = true;
                    stk_ior[stk_n] = irg;
                    stk_pri[stk_n] = spri;
                    stk_id[stk_n] = ivec2(sty, sidx);
                    stk_ent[stk_n] = hitp0;
                    stk_abs[stk_n] = alb.xyz;
                    ++stk_n;
                }
            }
            if (rough <= 0.0) {
                // Legacy delta path, bit-exact.
                // M68: thin-film Fresnel when film_d > 0 (alb2.y=film_d, alb2.z=film_n).
                float ratio = nest_ok ? nest_eta : (dot(d, n) < 0.0 ? (1.0 / irg) : irg);
                vec3 unit = normalize(d);
                vec3 nn = dot(d, n) < 0.0 ? n : -n;
                float cosT = min(dot(-unit, nn), 1.0);
                float sinT = sqrt(1.0 - cosT * cosT);
                attenuation = vec3(1.0);
                bool cannot_refract = ratio * sinT > 1.0;
                float film_d_g = alb2.y, film_n_g = alb2.z;
                float frefl;
                if (cannot_refract) {
                    frefl = 1.0;
                } else if (film_d_g > 0.0) {
                    // Film-coated glass: Airy on entry side (n0=1 entry, n0=irg exit approx).
                    bool front = dot(d, n) < 0.0;
                    float n0 = front ? 1.0 : irg;
                    vec3 Rf = film_R_rgb(n0, film_n_g, film_d_g, irg, 0.0, cosT);
                    // Hero-pick in spectral mode; luminance mean otherwise.
                    frefl = use_spectral() ? Rf[hero] : (Rf.r + Rf.g + Rf.b) / 3.0;
                } else {
                    frefl = schlick(cosT, ratio);
                }
                if (frefl > wrandf())
                    sd = reflect(unit, nn);
                else
                    sd = refract(unit, nn, ratio);
            } else {
                // Walter microfacet BTDF (mirrors CPU): VNDF + Fresnel
                // choice (weights cancel to G2/G1), face-forwarded frame.
                float ratio = nest_ok ? nest_eta : (dot(d, n) < 0.0 ? (1.0 / irg) : irg);
                vec3 V = -normalize(d);
                vec3 nn = dot(n, V) < 0.0 ? -n : n;
                vec3 u, v, w;
                wonb(nn, u, v, w);
                vec3 Vl = vec3(dot(V, u), dot(V, v), dot(V, w));
                float alpha = rough * rough;
                vec3 H;
                ggx_vndf(alpha, Vl, wrandf(), wrandf(), H); // H carries it
                float cosVH = dot(Vl, H);
                // M68: film Fresnel for rough glass when film_d > 0.
                float film_d_gr = alb2.y, film_n_gr = alb2.z;
                float F = 1.0;
                bool tir = true;
                if (cosVH > 0.0) {
                    float sinT2 = ratio * ratio * (1.0 - cosVH * cosVH);
                    if (sinT2 <= 1.0) {
                        tir = false;
                        float cv = min(cosVH, 1.0);
                        if (film_d_gr > 0.0) {
                            bool front2 = dot(d, n) < 0.0;
                            float n0gr = front2 ? 1.0 : irg;
                            vec3 Rfr = film_R_rgb(n0gr, film_n_gr, film_d_gr, irg, 0.0, cv);
                            F = use_spectral() ? Rfr[hero] : (Rfr.r + Rfr.g + Rfr.b) / 3.0;
                        } else {
                            float r0 = (1.0 - ratio) / (1.0 + ratio);
                            r0 *= r0;
                            float f = 1.0 - cv;
                            F = r0 + (1.0 - r0) * (f * f * f * f * f);
                        }
                    }
                }
                if (cosVH <= 0.0) {
                    ok = false; // degenerate microfacet, as CPU
                } else {
                    vec3 Ll;
                    if (tir || wrandf() < F) {
                        Ll = H * (2.0 * cosVH) - Vl;
                        if (Ll.z <= 0.0)
                            ok = false;
                    } else {
                        float k = 1.0 - ratio * ratio * (1.0 - cosVH * cosVH);
                        Ll = Vl * (-ratio) + H * (ratio * cosVH - sqrt(max(k, 0.0)));
                        float Llen = length(Ll);
                        if (Llen <= 0.0)
                            ok = false;
                        else
                            Ll /= Llen;
                        if (ok && Ll.z >= 0.0)
                            ok = false;
                    }
                    if (ok) {
                        float lv = ggx_lambda(alpha, Vl.z);
                        float gr =
                            (1.0 + lv) / (1.0 + lv + ggx_lambda(alpha, abs(Ll.z)));
                        attenuation = vec3(gr);
                        sd = u * Ll.x + v * Ll.y + w * Ll.z;
                    }
                }
            }
        } else if (mtype == MAT_DISNEY) {
            float metallic = alb.w;
            float rough = clamp(params.y, 0.0, 1.0);
            float specular = alb2.x;
            float spec_tint = alb2.y;
            float sheen = alb2.z;
            float sheen_tint = alb2.w;
            float clearcoat = emit.x;
            float coat_gloss = emit.y;
            float subsurface = emit.z;

            vec3 V = -normalize(d);
            vec3 nn = dot(n, V) < 0.0 ? -n : n;
            vec3 u, v, w;
            wonb(nn, u, v, w);
            vec3 Vl = vec3(dot(V, u), dot(V, v), dot(V, w));

            if (Vl.z <= 1e-6) {
                ok = false;
            } else {
                float lum = 0.3 * base_alb.x + 0.6 * base_alb.y + 0.1 * base_alb.z;
                vec3 c_tint = lum > 0.0 ? base_alb / lum : vec3(1.0);
                vec3 c_spec0 = (1.0 - metallic) * (0.08 * specular * mix(vec3(1.0), c_tint, spec_tint)) +
                               metallic * base_alb;
                vec3 c_sheen = mix(vec3(1.0), c_tint, sheen_tint);

                float w_diff = (1.0 - metallic) * 0.5;
                float w_spec = metallic + (1.0 - metallic) * 0.5;
                float w_coat = 0.25 * clearcoat;
                float w_sum = w_diff + w_spec + w_coat;

                if (w_sum <= 1e-7) {
                    ok = false;
                } else {
                    float xi = wrandf() * w_sum;
                    vec3 Ll;

                    if (xi < w_diff && w_diff > 1e-6) {
                        diffuse = true;
                        vec3 cd = wcosine_dir();
                        Ll = cd;
                        sd = u * Ll.x + v * Ll.y + w * Ll.z;

                        vec3 H = normalize(Vl + Ll);
                        float cos_theta_d = max(dot(Vl, H), 0.0);
                        float cos_theta_l = max(Ll.z, 0.0);
                        float cos_theta_v = max(Vl.z, 0.0);

                        float fd90 = 0.5 + 2.0 * rough * cos_theta_d * cos_theta_d;
                        float fl = 1.0 + (fd90 - 1.0) * pow(max(1.0 - cos_theta_l, 0.0), 5.0);
                        float fv = 1.0 + (fd90 - 1.0) * pow(max(1.0 - cos_theta_v, 0.0), 5.0);
                        vec3 fd = base_alb * (fl * fv);

                        if (subsurface > 0.0) {
                            float fss90 = rough * cos_theta_d * cos_theta_d;
                            float fss_l = 1.0 + (fss90 - 1.0) * pow(max(1.0 - cos_theta_l, 0.0), 5.0);
                            float fss_v = 1.0 + (fss90 - 1.0) * pow(max(1.0 - cos_theta_v, 0.0), 5.0);
                            vec3 fss = base_alb * (1.25 * (fss_l * fss_v * (1.0 / (cos_theta_l + cos_theta_v + 1e-5) - 0.5) + 0.5));
                            fd = mix(fd, fss, subsurface);
                        }

                        vec3 f_sheen = sheen * c_sheen * pow(max(1.0 - cos_theta_d, 0.0), 5.0);
                        attenuation = (fd * (1.0 - metallic) + f_sheen) * (w_sum / max(w_diff, 1e-6));
                    } else if (xi < w_diff + w_spec || w_coat <= 1e-4) {
                        float alpha = rough * rough;
                        alpha = clamp(alpha, 0.001, 1.0);
                        vec3 H;
                        Ll = ggx_vndf(alpha, Vl, wrandf(), wrandf(), H);
                        if (Ll.z <= 0.0) {
                            ok = false;
                        } else {
                            sd = u * Ll.x + v * Ll.y + w * Ll.z;
                            float cos_vh = max(dot(Vl, H), 0.0);
                            vec3 F = c_spec0 + (vec3(1.0) - c_spec0) * pow(max(1.0 - cos_vh, 0.0), 5.0);

                            float lv = ggx_lambda(alpha, Vl.z);
                            float ll = ggx_lambda(alpha, Ll.z);
                            float ratio = (1.0 + lv) / (1.0 + lv + ll);

                            attenuation = F * ratio * (w_sum / max(w_spec, 1e-6));
                        }
                    } else {
                        float gloss = clamp(coat_gloss, 0.0, 1.0);
                        float alpha_g = mix(0.1, 0.001, gloss);
                        float a2 = alpha_g * alpha_g;

                        float u1 = wrandf(), u2 = wrandf();
                        float cos_theta_h = sqrt(max(0.0, (1.0 - pow(max(a2, 1e-6), 1.0 - u1)) / max(1.0 - a2, 1e-6)));
                        float sin_theta_h = sqrt(max(0.0, 1.0 - cos_theta_h * cos_theta_h));
                        float phi_h = 6.28318530 * u2;

                        vec3 H = vec3(sin_theta_h * cos(phi_h), sin_theta_h * sin(phi_h), cos_theta_h);
                        Ll = 2.0 * dot(Vl, H) * H - Vl;
                        if (Ll.z <= 0.0) {
                            ok = false;
                        } else {
                            sd = u * Ll.x + v * Ll.y + w * Ll.z;
                            float cos_vh = max(dot(Vl, H), 0.0);
                            float F_coat = 0.04 + (1.0 - 0.04) * pow(max(1.0 - cos_vh, 0.0), 5.0);

                            attenuation = vec3(0.25 * clearcoat * F_coat) * (w_sum / max(w_coat, 1e-6));
                        }
                    }
                }
            }
        }
        // M67: channel-pick fresh attenuation (single choke point).
        attenuation = spick(attenuation, hero);
        if (!ok)
            break;
        if (diffuse && pc.nlights > 0 && !use_mix()) {
            int li = int(wrandf() * float(pc.nlights));
            li = min(li, pc.nlights - 1);
            vec3 lp, ln, lemit;
            float area;
            float eu1 = wrandf(), eu2 = wrandf();
            light_sample(li, rtime, eu1, eu2, lp, ln, area, lemit);
            // Shadow origin: exact surface point (no bias offset). Self-skims
            // are excluded by origin-prim id (skip), mirroring the CPU's
            // exact-origin + tmin contract; a lift would only perturb
            // neighbor clearances (M54: 1e-3 lift caused no harm but no
            // good either once skip exists).
            vec3 hitp = o + d * t;
            vec3 toL = lp - hitp;
            float dist = length(toL);
            vec3 wi = toL / dist;
            float cosS = dot(n, wi);
            float cosA = abs(dot(ln, -wi));
            if (cosS > 0.0 && cosA > 0.0 && area > 0.0) {
                // Transmittance-weighted NEE mirrors CPU: smoke attenuates
                // instead of binary-blocking. Draw-free (hashes/analytic).
                float Tr;
                if (pc.nfog > 0) {
                    // Range mirrors CPU (shadow clips dist - 0.001 itself).
                    Tr = shadow_transmittance(hitp, wi, rtime, pc.ns, dist,
                                              hbase, bounce, 1, sty, sidx);
                } else {
                    Tr = is_occluded(hitp, wi, rtime, dist - 0.001, sty, sidx)
                             ? 0.0
                             : 1.0;
                }
                if (Tr > 0.0) {
                    ivec2 le = lightTab[li];
                    int eimg = emit_image_index(le.x, le.y);
                    vec3 sle = spick((eimg >= 0)
                                                 ? image_sample(light_sample_uv(le.x, le.y, eu1, eu2),
                                                                eimg, dist)
                                                 : lemit,
                                           hero);
                    float pdf_l = dist * dist / (float(pc.nlights) * area * cosA);
                    float pdf_b = cosS / 3.14159265;
                    float w = power_weight(pdf_l, pdf_b);
                    L += throughput * attenuation * sle *
                         (cosS * cosA * float(pc.nlights) * area /
                          (3.14159265 * dist * dist)) * w * Tr;
                }
            }
        }
        if (pc.nenv > 0 && diffuse && !use_mix()) {
            // Environment NEE: sample from active env (analytic or HDRI CDF),
            // probe to infinity, power MIS vs cosine. 2 draws always consumed.
            float pdf_e = 0.0;
            vec3 edir = env_sample(wrandf(), wrandf(), pdf_e);
            float cosS = dot(n, edir);
            if (cosS > 0.0 && pdf_e > 0.0) {
                vec3 hitp = o + d * t;
                float Tr;
                if (pc.nfog > 0) {
                    Tr = shadow_transmittance(hitp, edir, rtime, pc.ns, 1e30,
                                              hbase, bounce, 2, sty, sidx);
                } else {
                    Tr = is_occluded(hitp, edir, rtime, 1e30, sty, sidx)
                             ? 0.0
                             : 1.0;
                }
                if (Tr > 0.0) {
                    vec3 envLe = spick(env_radiance(edir), hero);
                    float pdf_b = cosS / 3.14159265;
                    float w = power_weight(pdf_e, pdf_b);
                    L += throughput * attenuation * envLe *
                         (cosS / (3.14159265 * pdf_e)) * w * Tr;
                }
            }
        }
        if (diffuse) {
            if (use_mix()) {
                // Book mixture (M61): 50/50 cosine/light-aimed direction,
                // density from the traced reverse; weight by cosine/mix.
                // No shadow rays; emission counts full (specular below).
                vec3 md;
                // Branch order mirrors the host sample_mixture exactly
                // (cosine iff empty or coin<0.5): identical streams.
                if (pc.nlights == 0 || wrandf() < 0.5) {
                    vec3 u, v, w;
                    wonb(n, u, v, w);
                    vec3 cd = wcosine_dir();
                    md = u * cd.x + v * cd.y + w * cd.z;
                } else {
                    int mli = int(wrandf() * float(pc.nlights));
                    mli = min(mli, pc.nlights - 1);
                    vec3 mlp, mln, mlemit;
                    float marea;
                    light_sample(mli, rtime, wrandf(), wrandf(), mlp, mln, marea,
                                 mlemit);
                    md = normalize(mlp - hitp0);
                }
                vec3 mud = normalize(md);
                float cosb = max(dot(mud, n), 0.0) / 3.14159265;
                float pl = 0.0;
                if (pc.nlights > 0) {
                    // Reverse density: geometric pdf if md finds an emitter.
                    float ft;
                    vec3 fn;
                    vec4 fa, fab, fe, fp;
                    int fli, flt;
                    vec2 fuv;
                    vec3 ftg;
                    bool fht;
                    int fsy, fsi;
                    if (trace_solid(hitp0, mud, rtime, 1e30, ft, fn, fa, fab, fe,
                                    fp, fli, flt, fuv, ftg, fht, sty, sidx, 1e30,
                                    fsy, fsi) &&
                        flt >= 0) {
                        // mud is unit: ft is the distance, mud the direction.
                        vec3 fln;
                        float farea;
                        found_light(flt, fli, hitp0 + mud * ft, rtime, fln, farea);
                        float fcosA = abs(dot(fln, -mud));
                        if (fcosA > 0.0 && farea > 0.0)
                            pl = ft * ft / (float(pc.nlights) * farea * fcosA);
                    }
                }
                float pdf_mix = (pc.nlights > 0) ? 0.5 * (cosb + pl) : cosb;
                if (pdf_mix <= 0.0)
                    break; // degenerate: absorbed (mirrors CPU)
                throughput *= attenuation * (cosb / pdf_mix);
                sd = md;
                specular = true; // mixture: full counts, no MIS anywhere
            } else {
                vec3 wdir = normalize(sd);
                pdf_b_last = max(dot(wdir, n), 0.0) / 3.14159265;
                throughput *= attenuation;
                specular = false;
            }
        } else {
            throughput *= attenuation;
            specular = true;
        }
        prev = o + d * t;
        o = o + d * t;
        d = sd;
        // Next bounce skips this surface's self-skims (T-gated in trace).
        pty = sty;
        pidx = sidx;
        if (bounce >= 3) {
            float q = min(max(max(throughput.x, throughput.y), throughput.z), 0.95);
            if (q <= 0.0 || wrandf() > q)
                break;
            throughput /= q;
        }
    }
    // M67: single compensation for the 1/3 hero sampling probability.
    return use_spectral() ? L * 3.0 : L;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.W || p.y >= pc.H)
        return;
    wseed = uint(pc.seed) + uint(p.y * pc.W + p.x) * 1973u + 1u;
    // Stratified spp: host guarantees perfect square, passes side.
    int side = 1;
    for (; (side + 1) * (side + 1) <= pc.spp; ++side)
        ;
    vec3 acc = vec3(0.0);
    vec3 alb_acc = vec3(0.0);
    vec3 nrm_acc = vec3(0.0);
    int n = 0;
    for (int iy = 0; iy < side; ++iy)
        for (int ix = 0; ix < side; ++ix) {
            float ox = (float(ix) + wrandf()) / float(side);
            float oy = (float(iy) + wrandf()) / float(side);
            float u = (float(p.x) + ox) / float(pc.W);
            // Vulkan rows run top-first; flip so v=1 is up like the CPU.
            float v = 1.0 - (float(p.y) + oy) / float(pc.H);
            vec3 o = cam.origin.xyz;
            // Thin-lens Disk sample mirrors CPU (polar, 2 draws, gated so
            // pinhole streams stay bit-exact). Basis from viewport edges.
            vec3 target = cam.lower_left.xyz + u * cam.horiz.xyz + v * cam.vert.xyz;
            if (cam.lens.x > 0.0) {
                vec3 right = normalize(cam.horiz.xyz);
                vec3 up = normalize(cam.vert.xyz);
                float rr = cam.lens.x * sqrt(wrandf());
                float phi = 6.28318530718 * wrandf();
                o += (right * cos(phi) + up * sin(phi)) * rr;
            }
            vec3 d = target - o;
            // Shutter sample mirrors CPU (drawn last, stream order kept).
            float rt = (pc.sh1 > pc.sh0)
                           ? pc.sh0 + wrandf() * (pc.sh1 - pc.sh0)
                           : pc.sh0;
            vec3 ga, gn;
            acc += Li(o, d, rt, wseed, ga, gn);
            alb_acc += ga;
            nrm_acc += gn;
            ++n;
        }
    acc /= float(n);
    alb_acc /= float(n);
    nrm_acc /= float(n);
    // All-miss pixels keep zero guides; else renormalize (mirrors CPU).
    vec3 nrm_out = (dot(nrm_acc, nrm_acc) > 0.0) ? normalize(nrm_acc) : vec3(0.0);
    imageStore(img, p, vec4(acc, 1.0));
    imageStore(albImg, p, vec4(alb_acc, 1.0));
    imageStore(nrmImg, p, vec4(nrm_out, 1.0));
}
