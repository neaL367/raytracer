#version 450
// Megakernel path tracer: one invocation per pixel, full Li loop over the
// flat SoA scene. Mirrors path_tracer on the CPU operation for operation
// (same formulas, same order); fp32 arithmetic and independent RNG streams
// mean statistical parity (means within a few percent), never bit equality.
// Divergence across neighboring pixels is the known cost of this layout;
// wavefront staging is the later answer, not smuggled in here.
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform Push
{
    vec4 origin;
    vec4 llc;
    vec4 horiz;
    vec4 vert;
    uvec4 meta;  // width, height, n_spheres, n_tris
    uvec4 meta2; // n_quads, samples, strat_n, max_depth
    uvec4 meta3; // img0 width, img0 height, use_bvh, 0
} pc;

layout(binding = 0) readonly buffer Spheres
{
    vec4 sph[]; // xyz = center, w = radius
};

layout(binding = 1) readonly buffer Tris
{
    vec4 tri[]; // 3 per triangle
};

layout(binding = 2) readonly buffer Quads
{
    vec4 qd[]; // 3 per quad: corner, edge u, edge v
};

// Per-primitive material: albedo rgb (or emission rgb for lights),
// kind/wiring packed alongside. Indexed in the same order as the prims.
layout(binding = 3) readonly buffer SphMat
{
    vec4 sph_albedo[];
};

layout(binding = 4) readonly buffer SphMeta
{
    ivec4 sph_meta[]; // x = kind (0 lamb, 1 metal, 2 diel, 3 light)
};

layout(binding = 5) readonly buffer TriMat
{
    vec4 tri_albedo[];
};

layout(binding = 6) readonly buffer TriMeta
{
    ivec4 tri_meta[];
};

layout(binding = 7) readonly buffer QdMat
{
    vec4 qd_albedo[];
};

layout(binding = 8) readonly buffer QdMeta
{
    ivec4 qd_meta[];
};

// Checker parameters: scale + two colors per entry (only entry 0 used now).
layout(binding = 9) readonly buffer Checkers
{
    vec4 chk[]; // [scale, 0,0,0], [c1], [c2] per checker
};

// Image texture 0 as linear RGB floats (uv_check.ppm, same bytes as CPU).
layout(binding = 10) readonly buffer Img0
{
    float img0[];
};

layout(binding = 11) buffer Frame
{
    float pixels[];
};

// Flattened BVH: node boxes (min,max per node) plus one ivec4 array holding
// node links (left,right,leaf_start,leaf_count) followed by leaf refs
// (prim_type,prim_index,0,0). Starts are absolute ivec4 indices, so the
// arrays upload as-is with no pointer fixups.
layout(binding = 12) readonly buffer BvhBox
{
    vec4 bb[];
};

layout(binding = 13) readonly buffer BvhLink
{
    ivec4 bl[];
};

// --- hash RNG: unique stream per (pixel, sample), no shared state ---------
uint rng_state;

uint pcg_step()
{
    rng_state = rng_state * 747796405u + 2891336453u;
    uint w = ((rng_state >> ((rng_state >> 28u) + 4u)) ^ rng_state) * 277803737u;
    return (w >> 22u) ^ w;
}

float rand01()
{
    return float(pcg_step() >> 8) * (1.0 / 16777216.0);
}

// --- texture evaluation ----------------------------------------------------
vec3 tex_value(int kind, int index, vec2 uv, vec3 p)
{
    if (kind == 1) // checker: 3D sine product, mirrors checker_texture
    {
        float s = chk[index * 3].x;
        float sines = sin(p.x / s) * sin(p.y / s) * sin(p.z / s);
        vec3 c1 = chk[index * 3 + 1].xyz;
        vec3 c2 = chk[index * 3 + 2].xyz;
        return (sines < 0.0) ? c2 : c1;
    }
    if (kind == 2) // image 0, bilinear, mirrors image_texture
    {
        float u = clamp(uv.x, 0.0, 1.0);
        float v = clamp(1.0 - uv.y, 0.0, 1.0);
        float x = u * float(pc.meta3.x) - 0.5;
        float y = v * float(pc.meta3.y) - 0.5;
        int x0 = int(floor(x));
        int y0 = int(floor(y));
        float fx = x - float(x0);
        float fy = y - float(y0);
        int w = int(pc.meta3.x);
        int h = int(pc.meta3.y);
        int xa = clamp(x0, 0, w - 1);
        int xb = clamp(x0 + 1, 0, w - 1);
        int ya = clamp(y0, 0, h - 1);
        int yb = clamp(y0 + 1, 0, h - 1);
        vec3 c00 = vec3(img0[(ya * w + xa) * 3], img0[(ya * w + xa) * 3 + 1], img0[(ya * w + xa) * 3 + 2]);
        vec3 c10 = vec3(img0[(ya * w + xb) * 3], img0[(ya * w + xb) * 3 + 1], img0[(ya * w + xb) * 3 + 2]);
        vec3 c01 = vec3(img0[(yb * w + xa) * 3], img0[(yb * w + xa) * 3 + 1], img0[(yb * w + xa) * 3 + 2]);
        vec3 c11 = vec3(img0[(yb * w + xb) * 3], img0[(yb * w + xb) * 3 + 1], img0[(yb * w + xb) * 3 + 2]);
        return (c00 * ((1.0 - fx) * (1.0 - fy)) + c10 * (fx * (1.0 - fy)) +
                c01 * ((1.0 - fx) * fy) + c11 * (fx * fy)) / 255.0;
    }
    return vec3(1.0, 0.0, 1.0); // unknown kind: magenta, never silent
}

// --- orthonormal basis + cosine sampling, mirrors onb.h --------------------
void make_onb(vec3 n, out vec3 u, out vec3 v, out vec3 w)
{
    w = n;
    vec3 a = (abs(w.x) > 0.9) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    v = normalize(cross(w, a));
    u = cross(w, v);
}

vec3 cosine_sample(vec3 n)
{
    float r1 = rand01();
    float r2 = rand01();
    float phi = 2.0 * 3.14159265358979 * r1;
    vec3 d = vec3(cos(phi) * sqrt(r2), sin(phi) * sqrt(r2), sqrt(1.0 - r2));
    vec3 u, v, w;
    make_onb(n, u, v, w);
    return d.x * u + d.y * v + d.z * w;
}

// --- intersection (mirrors core intersectors) -------------------------------
bool hit_sphere(vec3 o, vec3 d, vec4 s, float tmin, float tmax, out float th, out vec3 n)
{
    vec3 oc = o - s.xyz;
    float a = dot(d, d);
    float hb = dot(oc, d);
    float c = dot(oc, oc) - s.w * s.w;
    float disc = hb * hb - a * c;
    if (disc < 0.0)
        return false;
    float sqrtd = sqrt(disc);
    float root = (-hb - sqrtd) / a;
    if (root < tmin || root > tmax)
    {
        root = (-hb + sqrtd) / a;
        if (root < tmin || root > tmax)
            return false;
    }
    th = root;
    vec3 outward = (o + d * root - s.xyz) / s.w;
    n = (dot(d, outward) < 0.0) ? outward : -outward;
    return true;
}

bool hit_tri(vec3 o, vec3 d, vec3 v0, vec3 v1, vec3 v2, float tmin, float tmax, out float th, out vec3 n)
{
    const float epsilon = 1e-8;
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 h = cross(d, edge2);
    float a = dot(edge1, h);
    if (abs(a) < epsilon)
        return false;
    float f = 1.0 / a;
    vec3 sv = o - v0;
    float u = f * dot(sv, h);
    if (u < 0.0 || u > 1.0)
        return false;
    vec3 q = cross(sv, edge1);
    float v = f * dot(d, q);
    if (v < 0.0 || u + v > 1.0)
        return false;
    float t = f * dot(edge2, q);
    if (t < tmin || t > tmax)
        return false;
    th = t;
    vec3 outward = normalize(cross(edge1, edge2));
    n = (dot(d, outward) < 0.0) ? outward : -outward;
    return true;
}

bool hit_quad(vec3 o, vec3 d, vec3 Q, vec3 u, vec3 v, float tmin, float tmax, out float th, out vec3 n)
{
    const float epsilon = 1e-8;
    vec3 nv = cross(u, v);
    vec3 normal = normalize(nv);
    float denom = dot(normal, d);
    if (abs(denom) < epsilon)
        return false;
    float D = dot(normal, Q);
    float t = (D - dot(normal, o)) / denom;
    if (t < tmin || t > tmax)
        return false;
    vec3 w = nv / dot(nv, nv);
    vec3 planar = o + d * t - Q;
    float alpha = dot(w, cross(planar, v));
    float beta = dot(w, cross(u, planar));
    if (alpha < 0.0 || alpha > 1.0 || beta < 0.0 || beta > 1.0)
        return false;
    th = t;
    n = (dot(d, normal) < 0.0) ? normal : -normal;
    return true;
}

vec3 sky(vec3 d)
{
    vec3 unit_dir = d / length(d);
    float a = 0.5 * (unit_dir.y + 1.0);
    return (1.0 - a) * vec3(1.0) + a * vec3(0.5, 0.7, 1.0);
}

float schlick(float cosine, float ref_idx)
{
    float r0 = (1.0 - ref_idx) / (1.0 + ref_idx);
    r0 = r0 * r0;
    return r0 + (1.0 - r0) * pow(1.0 - cosine, 5.0);
}

vec3 refract_cpu(vec3 uv, vec3 n, float eta)
{
    float cos_theta = min(dot(-uv, n), 1.0);
    vec3 r_perp = eta * (uv + cos_theta * n);
    vec3 r_par = -sqrt(abs(1.0 - dot(r_perp, r_perp))) * n;
    return r_perp + r_par;
}

// Quad light sampling for NEE (scene holds exactly one; general loop kept).
vec3 sample_quad(uint qi, out vec3 lp_normal, out float area)
{
    vec3 Q = qd[qi * 3u].xyz;
    vec3 u = qd[qi * 3u + 1u].xyz;
    vec3 v = qd[qi * 3u + 2u].xyz;
    vec3 nv = cross(u, v);
    lp_normal = normalize(nv);
    area = length(nv);
    return Q + rand01() * u + rand01() * v;
}

// traverse_any is defined after occluded() (with the other tree walkers).
bool traverse_any(vec3 o, vec3 d, float tmax);

bool occluded(vec3 o, vec3 d, float tmax)
{
    if (pc.meta3.z != 0u)
        return traverse_any(o, d, tmax);
    float th;
    vec3 n;
    for (uint i = 0u; i < pc.meta.z; ++i)
        if (hit_sphere(o, d, sph[i], 0.001, tmax, th, n))
            return true;
    for (uint i = 0u; i < pc.meta.w; ++i)
        if (hit_tri(o, d, tri[i * 3u].xyz, tri[i * 3u + 1u].xyz, tri[i * 3u + 2u].xyz, 0.001, tmax, th, n))
            return true;
    for (uint i = 0u; i < pc.meta2.x; ++i)
        if (hit_quad(o, d, qd[i * 3u].xyz, qd[i * 3u + 1u].xyz, qd[i * 3u + 2u].xyz, 0.001, tmax, th, n))
            return true;
    return false;
}

bool box_hit(vec3 bmin, vec3 bmax, vec3 o, vec3 inv, float tmin, float tmax)
{
    // Same slab arithmetic as the CPU box test: per-axis multiply by the
    // precomputed reciprocal, swap on negative, narrow, early exit.
    for (int a = 0; a < 3; ++a)
    {
        float t0 = (bmin[a] - o[a]) * inv[a];
        float t1 = (bmax[a] - o[a]) * inv[a];
        if (inv[a] < 0.0)
        {
            float tmp = t0;
            t0 = t1;
            t1 = tmp;
        }
        tmin = max(tmin, t0);
        tmax = min(tmax, t1);
        if (tmax <= tmin)
            return false;
    }
    return true;
}

bool test_prim(int type, int idx, vec3 o, vec3 d, float tmin, float tmax, out float th, out vec3 n)
{
    if (type == 0)
        return hit_sphere(o, d, sph[idx], tmin, tmax, th, n);
    if (type == 1)
        return hit_tri(o, d, tri[idx * 3].xyz, tri[idx * 3 + 1].xyz, tri[idx * 3 + 2].xyz,
                       tmin, tmax, th, n);
    return hit_quad(o, d, qd[idx * 3].xyz, qd[idx * 3 + 1].xyz, qd[idx * 3 + 2].xyz,
                    tmin, tmax, th, n);
}

void fetch_mat(int type, int idx, out vec3 alb, out float alb_w,
               out int kind, out int texk, out int texi)
{
    if (type == 0)
    {
        alb = sph_albedo[idx].xyz;
        alb_w = sph_albedo[idx].w;
        ivec4 m = sph_meta[idx];
        kind = m.x;
        texk = m.y;
        texi = m.z;
    }
    else if (type == 1)
    {
        alb = tri_albedo[idx].xyz;
        alb_w = tri_albedo[idx].w;
        ivec4 m = tri_meta[idx];
        kind = m.x;
        texk = m.y;
        texi = m.z;
    }
    else
    {
        alb = qd_albedo[idx].xyz;
        alb_w = qd_albedo[idx].w;
        ivec4 m = qd_meta[idx];
        kind = m.x;
        texk = m.y;
        texi = m.z;
    }
}

// Stack walk over the flat tree. Depth 32 covers the measured ~15 several
// times over; the guard below is against pathological future trees, and can
// only drop subtrees that cannot exist today.
bool traverse_closest(vec3 o, vec3 d, out float th, out vec3 n,
                      out vec3 alb, out float alb_w, out int kind, out int texk, out int texi)
{
    vec3 inv = vec3(1.0) / d; // inf on zero components, same as CPU 1.0/dir
    float closest = 1000.0;
    bool found = false;
    int stack[32];
    int sp = 0;
    stack[sp++] = 0;
    while (sp > 0)
    {
        int ni = stack[--sp];
        if (!box_hit(bb[ni * 2].xyz, bb[ni * 2 + 1].xyz, o, inv, 0.001, closest))
            continue;
        ivec4 link = bl[ni];
        if (link.x < 0)
        {
            for (int k = 0; k < link.w; ++k)
            {
                ivec4 ref = bl[link.z + k];
                float t;
                vec3 nn;
                if (test_prim(ref.x, ref.y, o, d, 0.001, closest, t, nn))
                {
                    closest = t;
                    n = nn;
                    fetch_mat(ref.x, ref.y, alb, alb_w, kind, texk, texi);
                    found = true;
                }
            }
        }
        else if (sp < 31)
        {
            stack[sp++] = link.y; // right first: left pops first
            stack[sp++] = link.x;
        }
    }
    th = closest;
    return found;
}

bool traverse_any(vec3 o, vec3 d, float tmax)
{
    vec3 inv = vec3(1.0) / d;
    int stack[32];
    int sp = 0;
    stack[sp++] = 0;
    while (sp > 0)
    {
        int ni = stack[--sp];
        if (!box_hit(bb[ni * 2].xyz, bb[ni * 2 + 1].xyz, o, inv, 0.001, tmax))
            continue;
        ivec4 link = bl[ni];
        if (link.x < 0)
        {
            for (int k = 0; k < link.w; ++k)
            {
                ivec4 ref = bl[link.z + k];
                float t;
                vec3 nn;
                if (test_prim(ref.x, ref.y, o, d, 0.001, tmax, t, nn))
                    return true;
            }
        }
        else if (sp < 31)
        {
            stack[sp++] = link.y;
            stack[sp++] = link.x;
        }
    }
    return false;
}

// Full path: NEE + MIS + RR, iterative (GPUs dislike recursion).
vec3 trace(vec3 o, vec3 d, int max_depth)
{
    vec3 color = vec3(0.0);
    vec3 throughput = vec3(1.0);
    // Emission weight of the incoming ray (MIS: bounce-found emission).
    // Primary rays carry 1.0: the camera sampled neither strategy.
    float emit_w = 1.0;

    for (int depth = max_depth; depth > 0; --depth)
    {
        // Closest hit, gathering material on the way. Tree walk and flat
        // scan share the intersectors; only the traversal differs, so the
        // flag below isolates traversal cost with identical shading.
        float closest = 1000.0;
        vec3 nrm = vec3(0.0);
        vec3 hit_p = vec3(0.0);
        vec3 alb = vec3(0.0);
        float alb_w = 0.0; // dielectric IOR rides here (upload convention)
        int kind = -1;   // 0 lamb, 1 metal, 2 diel, 3 light
        int texk = 0;    // 0 solid, 1 checker, 2 image
        int texi = -1;
        bool hit = false;
        float th;
        vec3 n;
        if (pc.meta3.z != 0u)
        {
            hit = traverse_closest(o, d, th, n, alb, alb_w, kind, texk, texi);
            closest = th;
            nrm = n;
        }
        else
        {
        for (uint i = 0u; i < pc.meta.z; ++i)
        {
            if (hit_sphere(o, d, sph[i], 0.001, closest, th, n))
            {
                closest = th;
                nrm = n;
                alb = sph_albedo[i].xyz;
                alb_w = sph_albedo[i].w;
                kind = sph_meta[i].x;
                texk = sph_meta[i].y;
                texi = sph_meta[i].z;
                hit = true;
            }
        }
        for (uint i = 0u; i < pc.meta.w; ++i)
        {
            if (hit_tri(o, d, tri[i * 3u].xyz, tri[i * 3u + 1u].xyz, tri[i * 3u + 2u].xyz, 0.001, closest, th, n))
            {
                closest = th;
                nrm = n;
                alb = tri_albedo[i].xyz;
                alb_w = tri_albedo[i].w;
                kind = tri_meta[i].x;
                texk = tri_meta[i].y;
                texi = tri_meta[i].z;
                hit = true;
            }
        }
        for (uint i = 0u; i < pc.meta2.x; ++i)
        {
            if (hit_quad(o, d, qd[i * 3u].xyz, qd[i * 3u + 1u].xyz, qd[i * 3u + 2u].xyz, 0.001, closest, th, n))
            {
                closest = th;
                nrm = n;
                alb = qd_albedo[i].xyz;
                alb_w = qd_albedo[i].w;
                kind = qd_meta[i].x;
                texk = qd_meta[i].y;
                texi = qd_meta[i].z;
                hit = true;
            }
        }
        }
        if (!hit)
        {
            color += throughput * sky(d);
            break;
        }
        hit_p = o + d * closest;

        // Diffuse albedo comes from the texture; others carry it directly.
        vec3 albedo = alb;
        if (kind == 0 && texk != 0)
            albedo = tex_value(texk, texi, vec2(0.0), hit_p);

        if (kind == 3) // emissive: no bounce
        {
            color += throughput * alb * emit_w;
            break;
        }

        bool specular = (kind == 1 || kind == 2);
        vec3 scattered;
        if (kind == 0)
        {
            scattered = cosine_sample(nrm);
        }
        else if (kind == 1)
        {
            vec3 ud = d / length(d);
            scattered = ud - 2.0 * dot(ud, nrm) * nrm;
            if (dot(scattered, nrm) <= 0.0)
                break;
        }
        else // dielectric: IOR rides in albedo.w (upload convention)
        {
            vec3 ud = d / length(d);
            // Front face test mirrors set_face_normal.
            bool front = dot(d, nrm) < 0.0;
            vec3 nn = front ? nrm : -nrm;
            float ior = (alb_w > 0.0) ? alb_w : 1.5;
            float ri = front ? (1.0 / ior) : ior;
            float cos_theta = min(dot(-ud, nn), 1.0);
            float sin_theta = sqrt(1.0 - cos_theta * cos_theta);
            bool cannot_refract = ri * sin_theta > 1.0;
            if (cannot_refract || schlick(cos_theta, ri) > rand01())
                scattered = ud - 2.0 * dot(ud, nn) * nn;
            else
                scattered = refract_cpu(ud, nn, ri);
        }

        // NEE on diffuse: explicit light sample, balance-weighted.
        if (!specular)
        {
            vec3 ln;
            float area;
            vec3 lp = sample_quad(0u, ln, area);
            vec3 to_l = lp - hit_p;
            float dist2 = dot(to_l, to_l);
            float dist = sqrt(dist2);
            vec3 ldir = to_l / dist;
            float cos_s = dot(nrm, ldir);
            float cos_l = dot(-ldir, ln);
            if (cos_s > 0.0 && cos_l > 0.0 && !occluded(hit_p, ldir, dist - 0.001))
            {
                float pl = dist2 / (cos_l * area);
                float cos_b = max(dot(nrm, ldir), 0.0);
                float ps = cos_b / 3.14159265358979;
                float w = (pl + ps > 0.0) ? pl / (pl + ps) : 0.0;
                color += throughput * albedo * qd_albedo[0].xyz * cos_s / pl * w;
            }
        }

        // MIS weight for emission the bounce may find.
        if (!specular)
        {
            vec3 sd = scattered / length(scattered);
            // Light pdf toward the bounce direction (single light: direct).
            vec3 to_q = qd[0].xyz - hit_p;
            // Reuse: pdf of sampling sd via the light = dist^2/(cos*area)
            // evaluated along sd through the quad plane.
            vec3 ln0 = normalize(cross(qd[1].xyz, qd[2].xyz));
            float denom = dot(ln0, sd);
            float pl = 0.0;
            if (abs(denom) > 1e-8)
            {
                float t = (dot(ln0, qd[0].xyz) - dot(ln0, hit_p)) / denom;
                if (t > 0.001)
                {
                    vec3 pp = hit_p + sd * t;
                    vec3 plan = pp - qd[0].xyz;
                    vec3 wv = cross(qd[1].xyz, qd[2].xyz);
                    wv = wv / dot(wv, wv);
                    float alpha = dot(wv, cross(plan, qd[2].xyz));
                    float beta = dot(wv, cross(qd[1].xyz, plan));
                    if (alpha >= 0.0 && alpha <= 1.0 && beta >= 0.0 && beta <= 1.0)
                    {
                        float cos_l = abs(dot(sd, ln0));
                        float area0 = length(cross(qd[1].xyz, qd[2].xyz));
                        if (cos_l > 1e-8)
                            pl = t * t / (cos_l * area0);
                    }
                }
            }
            float cos_b = max(dot(nrm, sd), 0.0);
            float ps = cos_b / 3.14159265358979;
            emit_w = (ps + pl > 0.0) ? ps / (ps + pl) : 1.0;
        }
        else
        {
            emit_w = 1.0;
        }

        // Russian roulette on the strongest channel.
        throughput *= albedo;
        float strongest = max(throughput.x, max(throughput.y, throughput.z));
        float rr_scale = 1.0;
        if (strongest < 0.9)
        {
            float q = max(strongest, 0.05);
            if (rand01() >= q)
                break;
            rr_scale = 1.0 / q;
        }
        throughput *= rr_scale;
        o = hit_p;
        d = scattered;
    }
    return color;
}

void main()
{
    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint w = pc.meta.x;
    uint h = pc.meta.y;
    if (x >= w || y >= h)
        return;

    uint samples = pc.meta2.y;
    uint strat_n = pc.meta2.z;
    int max_depth = int(pc.meta2.w);

    vec3 pixel = vec3(0.0);
    for (uint s_idx = 0u; s_idx < samples; ++s_idx)
    {
        // Unique decorrelated stream per (pixel, sample).
        rng_state = uint(x + y * w) * 1839712137u ^ s_idx * 2971215073u ^ 42u;
        pcg_step();

        float ox = rand01();
        float oy = rand01();
        ox = ((float(s_idx % strat_n)) + ox) / float(strat_n);
        oy = ((float(s_idx / strat_n)) + oy) / float(strat_n);
        float s = (float(x) + ox) / float(w - 1u);
        float t = (float(y) + oy) / float(h - 1u);
        vec3 o = pc.origin.xyz;
        vec3 d = pc.llc.xyz + s * pc.horiz.xyz + t * pc.vert.xyz - o;
        pixel += trace(o, d, max_depth);
    }
    pixel /= float(samples);

    uint i = (y * w + x) * 3u;
    pixels[i + 0u] = pixel.x;
    pixels[i + 1u] = pixel.y;
    pixels[i + 2u] = pixel.z;
}
